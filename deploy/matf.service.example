[Unit]
Description=Gunicorn za MatF App backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/matf-app
RuntimeDirectory=matf-app
Environment="HOME=/run/matf-app"
Environment="PATH=/var/www/matf-app/.venv/bin"
EnvironmentFile=/var/www/matf-app/deploy/matf.env
ExecStart=/var/www/matf-app/.venv/bin/gunicorn -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
