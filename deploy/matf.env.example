# Copy this file to /var/www/matf-app/matf.env and fill in the real values.

APP_ENV=production
APPLICATION_ROOT=/matf-app
STATIC_URL_PATH=/matf-app/static

# Teacher authentication
TEACHER_AUTH_MODE=radius
TEACHER_RADIUS_SERVER=147.91.66.2
TEACHER_RADIUS_SECRET=replace_with_teacher_radius_secret
TEACHER_RADIUS_DICTIONARY=/var/www/matf-app/radius/dictionary

# Student authentication
STUDENT_AUTH_MODE=radius
STUDENT_RADIUS_SERVER=replace_with_student_radius_server
STUDENT_RADIUS_SECRET=replace_with_student_radius_secret
STUDENT_RADIUS_DICTIONARY=/var/www/matf-app/radius/dictionary
REVIEW_MODE=0

# Application secrets
SECRET_KEY=replace_with_flask_secret_key
BACKEND_SERVICE_BEARER_TOKEN=replace_with_backend_service_bearer_token
ATTENDANCE_SECRET=replace_with_attendance_secret
MOBILE_ACTION_OTP_SECRET=replace_with_mobile_action_otp_secret
ATTENDANCE_CLASS_GRACE_MINUTES=15
ATTENDANCE_ATTEMPT_TTL=90
MOBILE_AUTH_SESSION_DAYS=30

# Firebase Cloud Messaging HTTP v1 sender credentials
FCM_PROJECT_ID=replace_with_firebase_project_id
FCM_SERVICE_ACCOUNT_FILE=/path/to/firebase-service-account.json

# Grades fetched from the central server
GRADES_SOURCE_URL=https://grades.example.edu/api/grades
GRADES_REQUEST_SIGNING_SECRET=replace_with_grades_request_signing_secret

# Hypatia exam application authorization
HYPATIA_EXAM_APPLICATIONS_URL=https://hypatia.example.edu/api/exam-applications
HYPATIA_LINK_URL=https://hypatia.example.edu/2fa/link
HYPATIA_REQUEST_SIGNING_SECRET=replace_with_hypatia_request_signing_secret
